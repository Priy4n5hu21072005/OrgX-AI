# Application Settings
PROJECT_NAME="OrgX-AI Authentication API"
API_V1_STR=""
ENVIRONMENT="development"

# Security & JWT
# Generate a secure key in production using: openssl rand -hex 32
JWT_SECRET_KEY="orgx-ai-super-secure-jwt-secret-key-change-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database (PostgreSQL default, falls back to SQLite if unreachable in dev)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/orgx_auth"

# Redis (For OTPs and temporary reset tokens)
REDIS_URL="redis://localhost:6379/0"
REDIS_OTP_EXPIRE_SECONDS=900
REDIS_RESET_TOKEN_EXPIRE_SECONDS=900

# Google OAuth 2.0 / OpenID Connect
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8000/auth/google/callback"

# Email Configuration (SMTP / Gmail)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="noreply@orgx-ai.com"
SMTP_FROM_NAME="OrgX-AI Security"
# When True, emails are logged to console instead of actually sent
EMAIL_MOCK_MODE=True

# Frontend URL (For password reset links and CORS)
FRONTEND_URL="http://localhost:3000"
